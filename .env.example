APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql+psycopg://scriptwriting:scriptwriting@db:5432/scriptwriting
APP_COOKIE_SECURE=true
APP_AUTO_CREATE_SCHEMA=false
APP_SESSION_TTL_SECONDS=28800
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-start
APP_BOOTSTRAP_SECRET=change-this-setup-secret

# Generate once with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep this key stable and back it up separately; it encrypts credentials and backups.
APP_EXTERNAL_ENCRYPTION_KEY=change-this-to-a-random-key-of-at-least-32-characters
APP_MODEL_TIMEOUT_SECONDS=120
APP_BACKUP_DIR=./backups
