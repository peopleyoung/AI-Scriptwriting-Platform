# Copy to .env and fill in real values. Never commit .env.
# In production (APP_ENVIRONMENT=production) the app refuses to start unless
# the encryption key, bootstrap secret and admin password pass Fail-Fast checks
# (length limits + no placeholder/weak values). Generate each secret once:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# For the admin password use a memorable value of at least 12 characters.

APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql+psycopg://scriptwriting:REPLACE_WITH_DB_PASSWORD@db:5432/scriptwriting
APP_COOKIE_SECURE=true
APP_AUTO_CREATE_SCHEMA=false
APP_SESSION_TTL_SECONDS=28800
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_MIN_12_CHARS
# At least 16 characters, no "change-this" placeholder.
APP_BOOTSTRAP_SECRET=REPLACE_WITH_RANDOM_SETUP_SECRET_MIN_16_CHARS

# Generate once with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep this key stable and back it up separately; it encrypts credentials and backups.
# Must be at least 32 characters with no placeholder text.
APP_EXTERNAL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_KEY_MIN_32_CHARS
APP_MODEL_TIMEOUT_SECONDS=120
# Days a trashed work stays restorable before automatic physical purge.
APP_TRASH_RETENTION_DAYS=30
APP_BACKUP_DIR=./backups
